# Copy to .env before starting: cp .env.example .env
# Local development defaults; change these in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
BACKEND_API_KEY=

# Optional: real OpenAI-compatible providers.
# Leave LLM/EMBEDDING blank to use the mock fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
